---
/**
 * Aviso destacado (datos en src/data/avisos.ts).
 *
 * - variante "urgente": fondo guinda, para avisos obligatorios.
 * - variante "importante": fondo ámbar, para avisos informativos.
 * - compacto: una sola línea con ícono, hora y lugar (sin título ni texto),
 *   para repetir un aviso que ya aparece completo en la misma página.
 *
 * El aviso no depende solo del color: siempre lleva la etiqueta escrita,
 * un ícono y un título.
 */
import type { Aviso } from "../data/avisos";
import {
  formatearDiaSemana,
  formatearFechaLarga,
  formatearHora,
} from "../data/formato";
import { withBase } from "../data/site";
import AlertIcon from "./icons/AlertIcon.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import CalendarIcon from "./icons/CalendarIcon.astro";
import ClockIcon from "./icons/ClockIcon.astro";
import GiftIcon from "./icons/GiftIcon.astro";
import PinIcon from "./icons/PinIcon.astro";

interface Props {
  aviso: Aviso;
  variante: "urgente" | "importante";
  /** Muestra el botón del enlace (si el aviso tiene uno). */
  mostrarEnlace?: boolean;
  compacto?: boolean;
  /** Nivel del título según la página: h2 por defecto. */
  nivel?: 2 | 3;
  /** Sufijo para los id cuando el mismo aviso aparece dos veces. */
  idSufijo?: string;
  class?: string;
}

const {
  aviso,
  variante,
  mostrarEnlace = true,
  compacto = false,
  nivel = 2,
  idSufijo = "",
  class: className,
} = Astro.props;

const Titulo = nivel === 3 ? "h3" : "h2";
const Icono = variante === "urgente" ? AlertIcon : GiftIcon;
const tituloId = `${aviso.id}${idSufijo}-titulo`;

// Solo los datos que tengan valor.
const datos = [
  aviso.fecha && {
    icon: CalendarIcon,
    label: "Fecha",
    texto: formatearFechaLarga(aviso.fecha),
    datetime: aviso.fecha,
  },
  aviso.hora && {
    icon: ClockIcon,
    label: "Hora",
    texto: formatearHora(aviso.hora),
    datetime: aviso.hora,
  },
  aviso.lugar && { icon: PinIcon, label: "Lugar", texto: aviso.lugar },
].filter((dato) => !!dato);

const enlace = mostrarEnlace ? aviso.enlace : undefined;
---

{
  compacto ? (
    <p
      role="note"
      aria-label={`${aviso.etiqueta}: ${aviso.titulo}`}
      class:list={["aviso-compacto", `aviso-compacto--${variante}`, className]}
    >
      <span class="aviso-compacto__icono">
        <Icono class="size-[1.125rem]" />
      </span>
      <span>
        <strong class="font-bold">Entrega:</strong>{" "}
        {/* "lunes 23 de noviembre, 10:00 a. m. · Lugar" (solo las partes con valor) */}
        {aviso.fecha && (
          <time datetime={aviso.fecha}>{formatearDiaSemana(aviso.fecha)}</time>
        )}
        {aviso.fecha && aviso.hora && ", "}
        {aviso.hora && <time datetime={aviso.hora}>{formatearHora(aviso.hora)}</time>}
        {(aviso.fecha || aviso.hora) && aviso.lugar && (
          <span aria-hidden="true"> · </span>
        )}
        {aviso.lugar && <span>{aviso.lugar}</span>}
      </span>
    </p>
  ) : (
    <div
      role="note"
      aria-labelledby={tituloId}
      class:list={[
        "aviso",
        `aviso--${variante}`,
        { "aviso--con-enlace": !!enlace },
        className,
      ]}
    >
      <span class="aviso__icono">
        <Icono class="size-8 sm:size-9 lg:size-10" />
      </span>

      <div class="aviso__cuerpo">
        <p class="aviso__etiqueta">{aviso.etiqueta}</p>

        <Titulo id={tituloId} class="aviso__titulo">
          {aviso.titulo}
        </Titulo>

        <p class="aviso__texto">{aviso.texto}</p>

        {datos.length > 0 && (
          <ul class="aviso__datos">
            {datos.map(({ icon: DatoIcon, label, texto, datetime }) => (
              <li class="aviso__dato">
                <DatoIcon class="size-[1.125rem] shrink-0" />
                <span class="sr-only">{label}:</span>
                {datetime ? <time datetime={datetime}>{texto}</time> : <span>{texto}</span>}
              </li>
            ))}
          </ul>
        )}
      </div>

      {enlace && (
        <a href={withBase(enlace.href)} class="aviso__btn">
          {enlace.label}
          <ArrowRightIcon class="size-5 shrink-0" />
        </a>
      )}
    </div>
  )
}

<style>
  /* ---------- Aviso completo ---------- */
  .aviso {
    --aviso-sombra: rgb(15 30 74 / 0.45);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: 1.75rem 1.25rem;
    border-radius: 1.25rem;
    text-align: center;
    box-shadow:
      0 2px 4px rgb(15 30 74 / 0.08),
      0 24px 44px -22px var(--aviso-sombra);
  }

  /* Franjas diagonales de marca, muy tenues, en la esquina superior derecha */
  .aviso::after {
    content: "";
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    width: 9rem;
    height: 9rem;
    background: repeating-linear-gradient(
      135deg,
      var(--aviso-franja) 0 0.875rem,
      transparent 0.875rem 1.75rem
    );
    -webkit-mask-image: linear-gradient(225deg, #000 0%, transparent 60%);
    mask-image: linear-gradient(225deg, #000 0%, transparent 60%);
    pointer-events: none;
  }

  .aviso--urgente {
    --aviso-sombra: rgb(122 18 48 / 0.6);
    --aviso-franja: rgb(255 255 255 / 0.07);
    background-image:
      radial-gradient(
        120% 140% at 0% 0%,
        rgb(255 255 255 / 0.1),
        transparent 55%
      ),
      linear-gradient(135deg, var(--color-guinda) 0%, var(--color-guinda-dark) 100%);
    color: #fff;
  }

  .aviso--importante {
    --aviso-sombra: rgb(160 100 0 / 0.55);
    --aviso-franja: rgb(15 30 74 / 0.06);
    background-image:
      radial-gradient(
        120% 140% at 0% 0%,
        rgb(255 255 255 / 0.25),
        transparent 55%
      ),
      linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
    color: var(--color-navy);
  }

  .aviso__icono {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
  }

  .aviso--urgente .aviso__icono {
    background: #fff;
    color: var(--color-guinda);
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.18),
      0 10px 20px -8px rgb(0 0 0 / 0.4);
  }

  .aviso--importante .aviso__icono {
    background: var(--color-navy);
    color: var(--color-gold);
    box-shadow:
      0 0 0 6px rgb(15 30 74 / 0.12),
      0 10px 20px -8px rgb(15 30 74 / 0.45);
  }

  .aviso__cuerpo {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
  }

  /* Píldora de la etiqueta (única parte animada) */
  .aviso__etiqueta {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.875rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .aviso--urgente .aviso__etiqueta {
    --pulso: rgb(255 194 51 / 0.65);
    background: var(--color-gold);
    color: var(--color-navy);
  }

  .aviso--importante .aviso__etiqueta {
    --pulso: rgb(15 30 74 / 0.45);
    background: var(--color-navy);
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .aviso__etiqueta {
      animation: aviso-pulso 2.4s ease-out infinite;
    }
  }

  @keyframes aviso-pulso {
    0% {
      box-shadow: 0 0 0 0 var(--pulso);
    }

    70%,
    100% {
      box-shadow: 0 0 0 0.625rem transparent;
    }
  }

  .aviso__titulo {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .aviso__texto {
    margin-top: 0.625rem;
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .aviso--urgente .aviso__texto {
    color: rgb(255 255 255 / 0.92);
  }

  .aviso__datos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.125rem;
  }

  .aviso__dato {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.875rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .aviso--urgente .aviso__dato {
    background: rgb(0 0 0 / 0.18);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  .aviso--importante .aviso__dato {
    background: rgb(255 255 255 / 0.45);
    box-shadow: inset 0 0 0 1px rgb(15 30 74 / 0.12);
  }

  /* Botón blanco con texto guinda */
  .aviso__btn {
    display: inline-flex;
    width: 100%;
    max-width: 22rem;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 3.25rem;
    padding-inline: 1.5rem;
    border-radius: 0.625rem;
    background: #fff;
    color: var(--color-guinda);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    box-shadow: 0 10px 20px -10px rgb(0 0 0 / 0.45);
    transition:
      background-color 200ms ease-out,
      color 200ms ease-out,
      box-shadow 200ms ease-out,
      transform 150ms ease-out;
  }

  .aviso__btn:hover {
    background: #fff5f7;
    color: var(--color-guinda-dark);
    box-shadow: 0 14px 26px -12px rgb(0 0 0 / 0.55);
  }

  .aviso__btn:active {
    transform: scale(0.98);
  }

  /* Celular angosto (≈ 360 px): texto y flecha en una sola línea */
  @media (width < 24rem) {
    .aviso__btn {
      gap: 0.375rem;
      padding-inline: 0.75rem;
      font-size: 0.875rem;
    }

    .aviso__btn :global(svg) {
      width: 1.125rem;
      height: 1.125rem;
    }
  }

  /* El azul del foco global se pierde sobre el guinda */
  .aviso--urgente .aviso__btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .aviso__btn:active {
      transform: none;
    }
  }

  /* Tableta y escritorio: ícono a la izquierda, contenido a la derecha */
  @media (width >= 48rem) {
    .aviso {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      align-items: start;
      column-gap: 1.75rem;
      row-gap: 1.5rem;
      padding: 2rem 2.25rem;
      text-align: left;
    }

    .aviso__icono {
      width: 4.5rem;
      height: 4.5rem;
    }

    .aviso__cuerpo {
      align-items: flex-start;
    }

    .aviso__datos {
      justify-content: flex-start;
    }

    .aviso__titulo {
      font-size: 1.625rem;
    }

    .aviso__btn {
      grid-column: 2;
      width: auto;
    }
  }

  /* Escritorio ancho: botón a la derecha del contenido */
  @media (width >= 64rem) {
    .aviso {
      column-gap: 2.25rem;
      padding: 2.5rem 3rem;
    }

    .aviso--con-enlace {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
    }

    .aviso--con-enlace .aviso__btn {
      grid-column: 3;
    }

    .aviso__icono {
      width: 5.5rem;
      height: 5.5rem;
    }

    .aviso--con-enlace .aviso__icono {
      align-self: start;
    }

    .aviso__titulo {
      font-size: 1.875rem;
    }

    .aviso__texto {
      font-size: 1.0625rem;
    }
  }

  /* ---------- Versión compacta (una línea) ---------- */
  .aviso-compacto {
    display: flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.35;
    box-shadow: 0 8px 18px -12px rgb(160 100 0 / 0.7);
  }

  /* "10:00 a. m." nunca se parte entre dos líneas */
  .aviso-compacto time {
    white-space: nowrap;
  }

  .aviso-compacto--importante {
    background-image: linear-gradient(
      135deg,
      var(--color-gold) 0%,
      var(--color-gold-dark) 100%
    );
    color: var(--color-navy);
  }

  .aviso-compacto--urgente {
    background-image: linear-gradient(
      135deg,
      var(--color-guinda) 0%,
      var(--color-guinda-dark) 100%
    );
    color: #fff;
  }

  .aviso-compacto__icono {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
  }

  .aviso-compacto--importante .aviso-compacto__icono {
    background: var(--color-navy);
    color: var(--color-gold);
  }

  .aviso-compacto--urgente .aviso-compacto__icono {
    background: #fff;
    color: var(--color-guinda);
  }

  @media (width >= 40rem) {
    .aviso-compacto {
      font-size: 0.9375rem;
    }
  }
</style>
