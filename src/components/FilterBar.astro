---
import { FILTER_EVENT, filters } from "../data/site";
import CalendarCheckIcon from "./icons/CalendarCheckIcon.astro";
import ChevronDownIcon from "./icons/ChevronDownIcon.astro";
import LayersIcon from "./icons/LayersIcon.astro";

const [defaultType] = filters.type.options;
---

<div
  class="rounded-2xl bg-surface p-4 sm:p-5 lg:flex lg:items-center lg:gap-7 lg:px-6"
  data-filter-bar
  data-event-name={FILTER_EVENT}
>
  <!-- Tipo de evento -->
  <div class="min-w-0 lg:flex-1">
    <p
      id="filtro-tipo"
      class="flex items-center gap-2 text-sm font-bold text-navy"
    >
      <LayersIcon class="size-[18px] shrink-0" />
      {filters.type.label}
    </p>
    <div
      class="scrollbar-none -mx-4 mt-2 flex gap-2.5 overflow-x-auto px-4 py-1.5 sm:-mx-5 sm:px-5 lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0"
      role="group"
      aria-labelledby="filtro-tipo"
    >
      {
        filters.type.options.map((option) => (
          <button
            type="button"
            class="chip"
            aria-pressed={option.value === defaultType.value ? "true" : "false"}
            data-filter-type={option.value}
          >
            {option.label}
          </button>
        ))
      }
    </div>
  </div>

  <span class="hidden w-px self-stretch bg-line lg:block" aria-hidden="true"
  ></span>

  <!-- Carrera -->
  <div
    class="mt-3 border-t border-line pt-4 lg:mt-0 lg:w-60 lg:shrink-0 lg:border-0 lg:pt-0"
  >
    <label
      for="filtro-carrera"
      class="flex items-center gap-2 text-sm font-bold text-navy"
    >
      <CalendarCheckIcon class="size-[18px] shrink-0" />
      {filters.career.label}
    </label>
    <div class="relative mt-3.5 lg:mt-3">
      <select
        id="filtro-carrera"
        class="field appearance-none pl-4 pr-11"
        data-filter-career
      >
        {
          filters.career.options.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))
        }
      </select>
      <ChevronDownIcon
        class="pointer-events-none absolute right-3.5 top-1/2 size-5 -translate-y-1/2 text-navy"
      />
    </div>
  </div>
</div>

<script>
  import type { EventFilterDetail } from "../data/site";

  const root = document.querySelector<HTMLElement>("[data-filter-bar]");

  if (root) {
    const eventName = root.dataset.eventName ?? "eventos:filtrar";
    const chips = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-filter-type]"),
    ];
    const select = root.querySelector<HTMLSelectElement>("[data-filter-career]");

    const state: EventFilterDetail = {
      type:
        chips.find((chip) => chip.getAttribute("aria-pressed") === "true")
          ?.dataset.filterType ?? "todos",
      career: select?.value ?? "todas",
    };

    // Las tarjetas de eventos escucharán este evento en `document`:
    //   document.addEventListener("eventos:filtrar", (e) => { e.detail.type; e.detail.career; });
    const emit = (): void => {
      document.dispatchEvent(
        new CustomEvent<EventFilterDetail>(eventName, { detail: { ...state } }),
      );
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        const type = chip.dataset.filterType;
        if (!type || type === state.type) return;

        state.type = type;
        for (const other of chips) {
          other.setAttribute("aria-pressed", String(other === chip));
        }
        chip.scrollIntoView({ block: "nearest", inline: "nearest" });
        emit();
      });
    }

    select?.addEventListener("change", () => {
      state.career = select.value;
      emit();
    });
  }
</script>
