---
import { Image } from "astro:assets";
import { cantidadLabel, kit } from "../data/kit";
import { withBase } from "../data/site";
import DiagonalStripes from "./decor/DiagonalStripes.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
---

<section
  id={kit.id}
  class="relative isolate overflow-hidden border-t border-line/70 bg-surface/60"
  aria-labelledby="kit-titulo"
>
  <!-- Franjas diagonales de marca, discretas, en la esquina superior derecha -->
  <DiagonalStripes
    class="pointer-events-none absolute right-0 top-0 -z-10 h-16 opacity-90 sm:h-20 lg:h-28"
  />

  <div class="site-container py-12 lg:py-16">
    <header class="max-w-2xl">
      <p
        class="font-display text-xs font-bold uppercase tracking-[0.14em] text-guinda sm:text-[13px]"
      >
        {kit.etiqueta}
      </p>
      <h2
        id="kit-titulo"
        class="mt-2 font-display text-[1.75rem] font-extrabold leading-tight tracking-tight text-navy sm:text-4xl"
      >
        {kit.titulo}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted lg:text-lg">
        {kit.texto}
      </p>
    </header>

    <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-10 lg:grid-cols-4 lg:gap-6">
      {
        kit.articulos.map((articulo) => (
          <li>
            <article class="kit-card group flex h-full flex-col overflow-hidden rounded-xl border border-line bg-white">
              <div
                class:list={[
                  "kit-media relative aspect-square overflow-hidden",
                  articulo.image ? "bg-white" : "bg-surface",
                ]}
              >
                {articulo.image ? (
                  <Image
                    src={articulo.image}
                    alt={articulo.alt}
                    widths={[200, 320, 480, 640]}
                    sizes="(min-width: 80rem) 290px, (min-width: 64rem) 22vw, 46vw"
                    loading="lazy"
                    class="kit-img size-full object-contain p-[10%]"
                  />
                ) : (
                  <div
                    class="kit-img flex size-full items-center justify-center"
                    role="img"
                    aria-label={articulo.alt}
                  >
                    <svg
                      class="size-[38%] text-navy/35"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      {articulo.id === "pluma" && (
                        <>
                          <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                          <path d="m15 5 4 4" />
                        </>
                      )}
                      {articulo.id === "playera" && (
                        <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z" />
                      )}
                      {articulo.id === "libreta" && (
                        <>
                          <path d="M2 6h4M2 10h4M2 14h4M2 18h4" />
                          <rect width="16" height="20" x="4" y="2" rx="2" />
                          <path d="M16 2v20" />
                        </>
                      )}
                      {articulo.id === "termo" && (
                        <>
                          <rect x="9" y="2" width="6" height="3" rx="1" />
                          <path d="M7 8a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2z" />
                          <path d="M7 11h10M7 17h10" />
                        </>
                      )}
                    </svg>
                  </div>
                )}

                <!-- Detalle diagonal en la esquina, como en el resto del sitio -->
                <span class="kit-corner" aria-hidden="true"></span>
              </div>

              <div class="flex flex-1 flex-wrap items-center justify-between gap-x-2 gap-y-1.5 border-t border-line/70 px-3 py-3 sm:px-4 sm:py-4">
                <h3 class="font-display text-base font-bold text-navy sm:text-lg">
                  {articulo.nombre}
                </h3>
                <span class="rounded-full bg-gold/25 px-2.5 py-0.5 text-xs font-semibold text-navy ring-1 ring-gold-dark/40 ring-inset sm:text-[13px]">
                  {cantidadLabel(articulo.cantidad)}
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex justify-center lg:mt-10">
      <a
        href={withBase(kit.boton.href)}
        class="kit-btn bg-gold-gradient shadow-[0_8px_18px_-10px_var(--color-gold-dark)] hover:brightness-105 hover:shadow-[0_12px_22px_-10px_var(--color-gold-dark)]"
      >
        {kit.boton.label}
        <ArrowRightIcon class="size-5" />
      </a>
    </div>
  </div>
</section>

<style>
  .kit-card {
    box-shadow: 0 8px 20px -14px rgb(15 30 74 / 0.4);
    transition:
      transform 220ms ease-out,
      box-shadow 220ms ease-out;
  }

  .kit-img {
    transition: transform 300ms ease-out;
  }

  /* Franja diagonal guinda/ámbar en la esquina superior derecha del área de imagen */
  .kit-corner {
    position: absolute;
    top: 0;
    right: 0;
    width: 2.25rem;
    height: 2.25rem;
    background: linear-gradient(
      225deg,
      var(--color-guinda) 0 22%,
      transparent 22% 34%,
      var(--color-gold) 34% 44%,
      transparent 44%
    );
    opacity: 0.85;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .kit-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 30px -18px rgb(15 30 74 / 0.45);
    }

    .kit-card:hover .kit-img {
      transform: scale(1.05);
    }
  }

  /* Mismo estilo que el botón de registro del hero, con ancho según el texto */
  .kit-btn {
    display: inline-flex;
    width: 100%;
    max-width: 22rem;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 3.375rem;
    padding-inline: 1.75rem;
    border-radius: 0.625rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-navy);
    transition:
      box-shadow 200ms ease-out,
      filter 200ms ease-out;
  }

  .kit-btn:active {
    transform: scale(0.98);
  }

  @media (width >= 40rem) {
    .kit-btn {
      width: auto;
    }
  }
</style>
