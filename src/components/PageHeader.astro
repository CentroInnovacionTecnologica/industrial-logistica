---
import { featured } from "../data/featured";
import DiagonalStripes from "./decor/DiagonalStripes.astro";
import DotGrid from "./decor/DotGrid.astro";
import EdgeChevrons from "./decor/EdgeChevrons.astro";
import Gears from "./decor/Gears.astro";

export interface PageStat {
  /** Componente de ícono (src/components/icons). */
  icon: (props: { class?: string }) => any;
  text: string;
  /** Texto completo para lectores de pantalla; sustituye a `text` si se da. */
  srText?: string;
}

interface Props {
  title: string;
  /**
   * Ruta después de "Inicio". La última es la página actual; las demás son
   * enlace si tienen `href` y texto si no (p. ej. "Actividades").
   */
  breadcrumb: { label: string; href?: string }[];
  /** Fila de datos con ícono. */
  stats: PageStat[];
}

const { title, breadcrumb, stats } = Astro.props;
const home = import.meta.env.BASE_URL;

const subtitle = [featured.eyebrow, featured.dates, featured.place];
const crumbs = [{ label: "Inicio", href: home }, ...breadcrumb];
---

<section
  class="relative isolate overflow-hidden bg-surface/60"
  aria-labelledby="pagina-titulo"
>
  <!-- Decoración: engranes, puntos, franjas diagonales y chevron del borde -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <Gears class="gears absolute text-navy" />
    <DotGrid id="cabecera-puntos" class="dots absolute text-navy" />
    <DiagonalStripes class="absolute right-0 top-0 h-16 sm:h-24 lg:h-full" />
    <EdgeChevrons variant="top" class="chevron absolute left-0" />
  </div>

  <div class="site-container py-6 lg:py-8">
    <nav aria-label="Ruta de navegación">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
        {
          crumbs.map((crumb, index) => {
            const isLast = index === crumbs.length - 1;
            return (
              <>
                {index > 0 && <li aria-hidden="true">/</li>}
                {isLast ? (
                  <li aria-current="page">{crumb.label}</li>
                ) : crumb.href ? (
                  <li>
                    <a
                      href={crumb.href}
                      class="rounded-sm underline-offset-4 transition-colors hover:text-navy hover:underline"
                    >
                      {crumb.label}
                    </a>
                  </li>
                ) : (
                  <li>{crumb.label}</li>
                )}
              </>
            );
          })
        }
      </ol>
    </nav>

    <h1
      id="pagina-titulo"
      class="mt-2 font-display text-[1.75rem] font-extrabold leading-tight tracking-tight text-navy sm:text-4xl lg:text-[2.75rem]"
    >
      {title}
    </h1>

    <p
      class="mt-1.5 flex flex-col text-[15px] italic text-muted sm:flex-row sm:flex-wrap sm:gap-x-2.5 lg:text-base"
    >
      {
        subtitle.map((part, index) => (
          <>
            {index > 0 && (
              <span class="hidden sm:inline" aria-hidden="true">
                ·
              </span>
            )}
            <span>{part}</span>
          </>
        ))
      }
    </p>

    <div class="stats-wrap mt-5 lg:mt-6">
      <ul
        class="stats flex flex-wrap items-center gap-x-5 gap-y-3 font-display text-[15px] font-bold text-navy sm:text-base lg:text-lg"
      >
        {
          stats.map((stat) => (
            <li class="stat flex items-center gap-2.5 sm:gap-3">
              <stat.icon class="size-6 shrink-0 text-accent-red sm:size-7 lg:size-8" />
              {stat.srText ? (
                <>
                  <span aria-hidden="true">{stat.text}</span>
                  <span class="sr-only">{stat.srText}</span>
                </>
              ) : (
                stat.text
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .gears {
    right: -3rem;
    bottom: -3rem;
    width: 12rem;
    opacity: 0.05;
  }

  .dots,
  .chevron {
    display: none;
  }

  /*
   * Líneas verticales finas entre los datos. Cada dato lleva su línea a la
   * izquierda y la lista se corre a la izquierda lo mismo que mide esa línea
   * más su relleno; el contenedor recorta lo que sobresale. Así, el primer
   * dato de cada renglón (también cuando la fila se parte en dos) queda sin
   * línea visible y alineado con el título.
   */
  @media (width >= 40rem) {
    .stats-wrap {
      overflow: hidden;
    }

    .stats {
      --stat-space: 1.75rem;
      column-gap: var(--stat-space);
      margin-left: calc(-1 * var(--stat-space) - 1px);
    }

    .stat {
      padding-left: var(--stat-space);
      border-left: 1px solid var(--color-line);
    }
  }

  @media (width >= 64rem) {
    .stats {
      --stat-space: 3rem;
    }

    .gears {
      top: -1.5rem;
      right: 17%;
      bottom: auto;
      width: 15rem;
      opacity: 0.07;
    }

    .dots {
      display: block;
      top: 2.75rem;
      right: calc(17% + 14.5rem);
      width: 2.5rem;
      opacity: 0.16;
    }

    .chevron {
      display: block;
      top: 0.75rem;
      width: clamp(1.25rem, 4.4vw - 1.7rem, 3.25rem);
    }
  }
</style>
