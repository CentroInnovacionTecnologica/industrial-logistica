---
import { registro } from "../data/registro";
import ClockIcon from "./icons/ClockIcon.astro";
import CloseIcon from "./icons/CloseIcon.astro";

interface Props {
  /** id del <dialog>; el botón que lo abre usa data-abre-dialogo con este valor. */
  id: string;
}

const { id } = Astro.props;
const tituloId = `${id}-titulo`;
---

<!-- Ventana modal nativa: showModal() da foco atrapado, Escape y capa superior -->
<dialog id={id} class="registro" aria-labelledby={tituloId}>
  <div class="registro__panel">
    <span class="registro__asa" aria-hidden="true"></span>

    <form method="dialog" class="contents">
      <button type="submit" class="registro__cerrar" aria-label={registro.acciones.cerrar}>
        <CloseIcon class="size-5" />
      </button>
    </form>

    <!-- Encabezado -->
    <div class="flex items-center gap-3 pr-12">
      <span
        class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-red/10 text-accent-red"
      >
        <ClockIcon class="size-5.5" />
      </span>
      <h2 id={tituloId} class="font-display text-xl font-bold leading-tight text-navy sm:text-2xl">
        {registro.titulo}
      </h2>
    </div>

    <p class="mt-4 leading-relaxed text-muted">
      {registro.intro.antes}{" "}
      <strong class="font-semibold text-navy">{registro.lugar}</strong>{registro.intro.despues}
    </p>

    {
      registro.periodo && (
        <p class="mt-4 rounded-lg border border-line px-4 py-2.5 font-display text-[15px] font-semibold text-navy">
          {registro.periodo}
        </p>
      )
    }

    <!-- Días y horarios de atención -->
    <dl class="registro__horarios">
      {
        registro.horarios.map(({ dia, horarios }) => (
          <div class="registro__fila">
            <dt class="font-display font-bold text-navy">{dia}</dt>
            <dd>
              <ul class="tabular-nums">
                {horarios.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    {
      registro.requisitos.length > 0 && (
        <div class="mt-5">
          <h3 class="font-display font-bold text-navy">Qué debes llevar</h3>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-muted marker:text-accent-red">
            {registro.requisitos.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>
      )
    }

    <p class="mt-5 font-display text-lg font-bold text-navy">{registro.cierre}</p>

    <!-- Acciones -->
    <div class="registro__acciones">
      {
        registro.formularioUrl && (
          <a
            href={registro.formularioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="registro__btn bg-gold-gradient shadow-[0_8px_18px_-10px_var(--color-gold-dark)] hover:brightness-105"
          >
            {registro.acciones.enLinea}
          </a>
        )
      }
      <form method="dialog" class="contents">
        <button
          type="submit"
          class="registro__btn border-[1.5px] border-navy bg-white hover:bg-navy hover:text-white"
        >
          {registro.acciones.entendido}
        </button>
      </form>
    </div>
  </div>
</dialog>

<script>
  /** Ancho de la barra de desplazamiento, para que la página no "salte" al bloquearla. */
  function bloquearFondo(bloquear: boolean) {
    const html = document.documentElement;
    if (bloquear) {
      const barra = window.innerWidth - html.clientWidth;
      html.style.overflow = "hidden";
      if (barra > 0) html.style.paddingRight = `${barra}px`;
    } else {
      html.style.overflow = "";
      html.style.paddingRight = "";
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-abre-dialogo]").forEach((boton) => {
    const dialogo = document.getElementById(boton.dataset.abreDialogo!);
    if (!(dialogo instanceof HTMLDialogElement)) return;

    boton.addEventListener("click", () => {
      dialogo.showModal();
      bloquearFondo(true);
    });

    // Clic o toque fuera del panel: el propio <dialog> solo recibe el evento en el fondo
    dialogo.addEventListener("click", (e) => {
      if (e.target === dialogo) dialogo.close();
    });

    // Cualquier forma de cierre (X, "Entendido", Escape, fuera del panel)
    dialogo.addEventListener("close", () => {
      bloquearFondo(false);
      boton.focus();
    });
  });
</script>

<style>
  /* ── Ventana (escritorio y tableta: centrada) ───────────────────── */
  .registro {
    width: calc(100% - 2rem);
    max-width: 35rem; /* 560 px */
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 1rem;
    background: #fff;
    color: var(--color-navy);
    box-shadow:
      0 24px 48px -12px rgb(15 30 74 / 0.28),
      0 2px 6px rgb(15 30 74 / 0.08);
    overscroll-behavior: contain;
  }

  .registro::backdrop {
    background: rgb(10 21 54 / 0.55);
    backdrop-filter: blur(3px);
  }

  .registro[open] {
    animation: registro-entra 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .registro[open]::backdrop {
    animation: registro-fondo 220ms ease-out;
  }

  .registro__panel {
    position: relative;
    padding: 1.75rem 1.75rem 1.5rem;
  }

  /* Barrita de arrastre: solo en el panel inferior de celular */
  .registro__asa {
    display: none;
  }

  .registro__cerrar {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-muted);
    transition:
      background-color 200ms ease-out,
      color 200ms ease-out;
  }

  .registro__cerrar:hover {
    background: var(--color-surface);
    color: var(--color-navy);
  }

  /* ── Horarios: día a la izquierda, bloques a la derecha ────────── */
  .registro__horarios {
    margin-top: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
  }

  .registro__fila {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 1rem;
    padding: 0.875rem 1.125rem;
  }

  .registro__fila:nth-child(even) {
    background: var(--color-surface);
  }

  .registro__fila + .registro__fila {
    border-top: 1px solid var(--color-line);
  }

  .registro__fila dd {
    color: var(--color-navy);
    line-height: 1.6;
  }

  /* ── Botones del pie ────────────────────────────────────────────── */
  .registro__acciones {
    display: flex;
    flex-flow: row-reverse wrap; /* acción principal a la derecha */
    justify-content: flex-start;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .registro__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.875rem;
    padding-inline: 1.5rem;
    border-radius: 0.625rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    transition:
      background-color 200ms ease-out,
      color 200ms ease-out,
      filter 200ms ease-out;
  }

  .registro__btn:active {
    transform: scale(0.98);
  }

  /* ── Celular (< 640 px): panel que sube desde abajo ────────────── */
  @media (width < 40rem) {
    .registro {
      width: 100%;
      max-width: 100%;
      max-height: 90dvh;
      margin: auto 0 0;
      border-radius: 1.25rem 1.25rem 0 0;
      overflow-y: auto;
    }

    .registro[open] {
      animation-name: registro-sube;
      animation-duration: 260ms;
    }

    .registro__panel {
      padding: 0.75rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom));
    }

    .registro__asa {
      display: block;
      width: 2.5rem;
      height: 0.3125rem;
      margin: 0 auto 1.25rem;
      border-radius: 999px;
      background: var(--color-line);
    }

    .registro__cerrar {
      top: 1.5rem;
      right: 0.75rem;
    }

    /* Día arriba y sus horarios debajo */
    .registro__fila {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding: 0.75rem 1rem;
    }

    .registro__acciones {
      flex-direction: column; /* acción principal arriba */
    }

    .registro__btn {
      width: 100%;
      min-height: 3rem;
    }
  }

  @keyframes registro-entra {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  @keyframes registro-sube {
    from {
      transform: translateY(100%);
    }
  }

  @keyframes registro-fondo {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .registro[open],
    .registro[open]::backdrop {
      animation: none;
    }
  }
</style>
