---
import { formatearFecha, valor } from "../../data/conferencias";
import type { Conferencia } from "../../data/conferencias";
import CalendarIcon from "../icons/CalendarIcon.astro";
import ClockIcon from "../icons/ClockIcon.astro";
import PinIcon from "../icons/PinIcon.astro";
import UserIcon from "../icons/UserIcon.astro";
import Card from "../ui/Card.astro";
import CardFacts from "../ui/CardFacts.astro";
import { tonos } from "../ui/tonos";

interface Props {
  conferencia: Conferencia;
}

const { conferencia } = Astro.props;

// Los campos vacíos no se muestran (ni el dato ni su ícono).
const alias = valor(conferencia.alias);
const cargo = valor(conferencia.cargo);
const descripcion = valor(conferencia.descripcion);
const frase = valor(conferencia.frase);
const fecha = valor(conferencia.fecha);
const hora = valor(conferencia.hora);
const lugar = valor(conferencia.lugar);

const tieneDatos = Boolean(fecha || hora || lugar);
const sinDetalles = !descripcion && !tieneDatos;
---

<Card stripe={tonos.industrial.stripe}>
  <p
    class:list={[
      "self-start rounded-2xl px-3 py-1.5 text-[13px] font-medium leading-tight",
      tonos.industrial.chip,
    ]}
  >
    Conferencia
  </p>

  <h3 class="mt-4 font-display text-lg font-bold leading-snug text-navy">
    {conferencia.titulo}
  </h3>

  <p class="mt-3 flex items-start gap-2 text-[15px] leading-snug text-navy">
    <UserIcon class="mt-px size-5 shrink-0" />
    <span>
      <span class="sr-only">Ponente:</span>
      <strong class="font-bold">{conferencia.ponente}</strong>
      {alias && <span>{" "}“{alias}”</span>}
      {cargo && <span class="mt-0.5 block text-[13px] text-muted">{cargo}</span>}
    </span>
  </p>

  {
    (descripcion || frase) && (
      <div class="mt-3 space-y-3 pb-5">
        {descripcion && (
          <p class="text-[15px] leading-relaxed text-muted">{descripcion}</p>
        )}
        {frase && (
          <p class="text-[15px] font-medium italic leading-relaxed text-guinda">
            {frase}
          </p>
        )}
      </div>
    )
  }

  {
    tieneDatos && (
      <CardFacts>
        {fecha && (
          <li>
            <CalendarIcon class="size-5 shrink-0 text-accent-red" />
            <span>
              <span class="sr-only">Fecha:</span>
              <time datetime={fecha} class="text-sm font-bold">
                {formatearFecha(fecha)}
              </time>
            </span>
          </li>
        )}
        {hora && (
          <li>
            <ClockIcon class="size-5 shrink-0" />
            <span>
              <span class="sr-only">Hora:</span>
              <time datetime={hora} class="text-sm font-bold">
                {hora}
              </time>
            </span>
          </li>
        )}
        {lugar && (
          <li>
            <PinIcon class="size-5 shrink-0 text-accent-red" />
            <span>
              <span class="sr-only">Lugar:</span>
              <strong class="text-sm font-bold">{lugar}</strong>
            </span>
          </li>
        )}
      </CardFacts>
    )
  }

  {
    sinDetalles && (
      <div class="mt-auto pt-5">
        <p class="border-t border-line pt-4 text-sm text-muted">
          Pronto compartiremos más detalles.
        </p>
      </div>
    )
  }
</Card>
