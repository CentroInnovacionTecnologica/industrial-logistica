---
import { carreraLabels, formatSemestres } from "../../data/cursos";
import type { Curso } from "../../data/cursos";
import ClockIcon from "../icons/ClockIcon.astro";
import DownloadIcon from "../icons/DownloadIcon.astro";
import GraduationCapIcon from "../icons/GraduationCapIcon.astro";
import LaptopIcon from "../icons/LaptopIcon.astro";
import Card from "../ui/Card.astro";
import CardFacts from "../ui/CardFacts.astro";
import CupoInfo from "../ui/CupoInfo.astro";
import { calcularCupo } from "../ui/cupo";
import { tonos } from "../ui/tonos";

interface Props {
  curso: Curso;
}

const { curso } = Astro.props;

const tone = tonos[curso.carrera];
const PENDING = "Por confirmar";

const openTo =
  curso.abiertoAOtraCarrera && curso.carrera !== "ambas"
    ? `Abierto a ${carreraLabels[curso.carrera === "industrial" ? "logistica" : "industrial"]}`
    : null;

const requisitos = curso.requisitos ?? [];
const requisitosId = `requisitos-${curso.id}`;

const cupo = { capacidad: curso.lugares, inscritos: curso.inscritos };
const lleno =
  curso.lugares !== null &&
  calcularCupo(curso.lugares, curso.inscritos).estado === "lleno";
---

<Card stripe={tone.stripe} atenuada={lleno}>
  <div class="flex items-start justify-between gap-3">
    <p
      class:list={[
        "rounded-2xl px-3 py-1.5 text-[13px] font-medium leading-tight",
        tone.chip,
      ]}
    >
      <span class="sr-only">Tema:</span>
      {curso.tema}
    </p>
    <div class="flex shrink-0 flex-col items-end gap-1.5">
      <p
        class:list={[
          "rounded-full px-3 py-1.5 text-[13px] font-semibold leading-tight",
          tone.tag,
        ]}
      >
        <span class="sr-only">Carrera:</span>
        {carreraLabels[curso.carrera]}
      </p>
      <CupoInfo parte="etiqueta" {...cupo} />
      {openTo && <p class="text-xs font-medium text-muted">{openTo}</p>}
    </div>
  </div>

  <h3 class="mt-4 font-display text-lg font-bold leading-snug text-navy">
    {curso.nombre}
  </h3>
  <p class="mt-2 pb-5 text-[15px] leading-relaxed text-muted">
    {curso.descripcion}
  </p>

  {
    requisitos.length > 0 && (
      <section
        class="mb-5 rounded-lg bg-surface px-4 py-3 text-sm leading-snug text-navy"
        aria-labelledby={requisitosId}
      >
        <h4
          id={requisitosId}
          class="flex items-center gap-1.5 text-[13px] font-bold"
        >
          <LaptopIcon class="size-4 shrink-0" />
          Requisitos
        </h4>
        <ul class="mt-1.5 list-disc space-y-1 pl-5 marker:text-navy/50">
          {requisitos.map((requisito) => (
            <li>{requisito}</li>
          ))}
        </ul>
        {curso.enlace && (
          <a
            href={curso.enlace.url}
            target="_blank"
            rel="noopener noreferrer"
            class="requisitos-enlace mt-1.5 inline-flex min-h-11 items-center gap-1.5 rounded-sm font-semibold underline decoration-navy/40 underline-offset-4 transition-colors hover:decoration-navy"
          >
            <DownloadIcon class="size-4 shrink-0" />
            {curso.enlace.texto}
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        )}
      </section>
    )
  }

  <!-- Datos del curso, pegados al fondo de la tarjeta -->
  <CardFacts>
    <li>
      <GraduationCapIcon class="size-5 shrink-0" />
      <span>
        <span class="sr-only">Semestres:</span>
        <strong class="block whitespace-nowrap text-sm font-bold">
          {formatSemestres(curso.semestres)}
        </strong>
        semestre
      </span>
    </li>
    <li>
      <ClockIcon class="size-5 shrink-0" />
      <span>
        <span class="sr-only">Duración:</span>
        {
          curso.duracionHoras === null ? (
            <span class="font-medium text-muted">{PENDING}</span>
          ) : (
            <strong class="text-sm font-bold">
              {curso.duracionHoras}&nbsp;h
            </strong>
          )
        }
      </span>
    </li>
    <CupoInfo parte="dato" {...cupo} />
  </CardFacts>
  <CupoInfo parte="barra" {...cupo} />
</Card>


<style>
  .requisitos-enlace:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }
</style>
