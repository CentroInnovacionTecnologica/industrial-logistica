---
import {
  carreraLabels,
  destinoDe,
  formatSemestres,
  fusionadosEn,
} from "../../data/cursos";
import type { Curso } from "../../data/cursos";
import ArrowRightIcon from "../icons/ArrowRightIcon.astro";
import ClockIcon from "../icons/ClockIcon.astro";
import DownloadIcon from "../icons/DownloadIcon.astro";
import GraduationCapIcon from "../icons/GraduationCapIcon.astro";
import HistoryIcon from "../icons/HistoryIcon.astro";
import LaptopIcon from "../icons/LaptopIcon.astro";
import MergeIcon from "../icons/MergeIcon.astro";
import PinIcon from "../icons/PinIcon.astro";
import UsersIcon from "../icons/UsersIcon.astro";
import Card from "../ui/Card.astro";
import CardFacts from "../ui/CardFacts.astro";
import CupoInfo from "../ui/CupoInfo.astro";
import { calcularCupo } from "../ui/cupo";
import { tonos } from "../ui/tonos";

interface Props {
  curso: Curso;
}

const { curso } = Astro.props;

const tone = tonos[curso.carrera];
const PENDING = "Por confirmar";

const openTo =
  curso.abiertoAOtraCarrera && curso.carrera !== "ambas"
    ? `Abierto a ${carreraLabels[curso.carrera === "industrial" ? "logistica" : "industrial"]}`
    : null;

const aulaPendiente = curso.aula === PENDING;

const requisitos = curso.requisitos ?? [];
const requisitosId = `requisitos-${curso.id}`;

const cupo = { capacidad: curso.lugares, inscritos: curso.inscritos };
// Curso fusionado: se integra a `destino`. No muestra cupo (ni etiqueta, ni
// barra, ni atenuado por lleno).
const destino = destinoDe(curso);
// Curso destino: los cursos que se le integran.
const integrados = fusionadosEn(curso);
const lleno =
  !destino &&
  curso.lugares !== null &&
  calcularCupo(curso.lugares, curso.inscritos).estado === "lleno";
---

<Card
  stripe={tone.stripe}
  atenuada={lleno}
  ariaLabel={destino ? `Curso fusionado con ${destino.nombre}: ${curso.nombre}` : undefined}
  contenidoClass={destino ? "fusionado-contenido" : undefined}
>
  {
    destino && (
      <Fragment slot="aviso">
        <!-- Cinta diagonal: decorativa, el aviso de la franja ya lo dice -->
        <div class="cinta" aria-hidden="true">
          <span>Se fusiona</span>
        </div>
        <div class="franja-fusionado flex shrink-0 items-start gap-2.5 bg-amber py-4 pl-5 text-navy">
          <MergeIcon class="mt-0.5 size-7 shrink-0" />
          <div class="min-w-0">
            <p class="font-display text-xl font-extrabold leading-tight">
              Curso fusionado
            </p>
            <p class="mt-1.5 text-sm font-medium leading-snug">
              Este curso se integra a <strong class="font-bold">«{destino.nombre}»</strong>,
              que cubre temas muy similares. Si te inscribiste, acude al
              Departamento de Ingeniería Industrial.
            </p>
            <!-- Sin JavaScript el ancla basta (se muestran todos los cursos);
                 con JavaScript, cursos.astro quita filtros, cambia de página y
                 resalta el destino. -->
            <a
              href={`#curso-${destino.id}`}
              class="ver-curso mt-3 inline-flex min-h-11 items-center gap-2 rounded-[0.625rem] bg-navy px-4 font-display text-sm font-bold text-white transition-colors hover:bg-navy-700"
              data-ir-a-curso={destino.id}
            >
              Ver el curso
              <span class="sr-only">«{destino.nombre}»</span>
              <ArrowRightIcon class="size-4 shrink-0" />
            </a>
          </div>
        </div>
      </Fragment>
    )
  }

  <div class="flex items-start justify-between gap-3">
    <p
      class:list={[
        "rounded-2xl px-3 py-1.5 text-[13px] font-medium leading-tight",
        tone.chip,
      ]}
    >
      <span class="sr-only">Tema:</span>
      {curso.tema}
    </p>
    <div class="flex shrink-0 flex-col items-end gap-1.5">
      <p
        class:list={[
          "rounded-full px-3 py-1.5 text-[13px] font-semibold leading-tight",
          tone.tag,
        ]}
      >
        <span class="sr-only">Carrera:</span>
        {carreraLabels[curso.carrera]}
      </p>
      {!destino && <CupoInfo parte="etiqueta" {...cupo} />}
      {openTo && <p class="text-xs font-medium text-muted">{openTo}</p>}
    </div>
  </div>

  <h3
    class:list={[
      "mt-4 font-display text-lg font-bold leading-snug text-navy",
      destino && "line-through decoration-2",
    ]}
  >
    {curso.nombre}
  </h3>
  {
    integrados.map((integrado) => (
      <p class="mt-1 flex items-start gap-1.5 text-[13px] font-semibold leading-snug text-amber-dark">
        <MergeIcon class="mt-px size-3.5 shrink-0" />
        <span>Integra el curso «{integrado.nombre}»</span>
      </p>
    ))
  }
  {
    curso.nombreAnterior && (
      <p class="mt-1 flex items-start gap-1.5 text-[13px] leading-snug text-muted">
        <HistoryIcon class="mt-px size-3.5 shrink-0" />
        <span>Antes: {curso.nombreAnterior}</span>
      </p>
    )
  }
  <p class="mt-2 pb-5 text-[15px] leading-relaxed text-muted">
    {curso.descripcion}
  </p>

  {
    requisitos.length > 0 && (
      <section
        class="mb-5 rounded-lg bg-surface px-4 py-3 text-sm leading-snug text-navy"
        aria-labelledby={requisitosId}
      >
        <h4
          id={requisitosId}
          class="flex items-center gap-1.5 text-[13px] font-bold"
        >
          <LaptopIcon class="size-4 shrink-0" />
          Requisitos
        </h4>
        <ul class="mt-1.5 list-disc space-y-1 pl-5 marker:text-navy/50">
          {requisitos.map((requisito) => (
            <li>{requisito}</li>
          ))}
        </ul>
        {curso.enlace && (
          <a
            href={curso.enlace.url}
            target="_blank"
            rel="noopener noreferrer"
            class="requisitos-enlace mt-1.5 inline-flex min-h-11 items-center gap-1.5 rounded-sm font-semibold underline decoration-navy/40 underline-offset-4 transition-colors hover:decoration-navy"
          >
            <DownloadIcon class="size-4 shrink-0" />
            {curso.enlace.texto}
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        )}
      </section>
    )
  }

  <!-- Aula y datos del curso, pegados al fondo de la tarjeta -->
  <div class="mt-auto">
    <p
      class:list={[
        "mb-3 flex items-start gap-1.5 text-[13px] font-semibold leading-snug",
        aulaPendiente ? "text-muted" : "text-navy",
      ]}
    >
      <PinIcon class="mt-px size-4 shrink-0" />
      <span class="min-w-0 break-words">
        <span class="sr-only">Aula:</span>
        {curso.aula}
      </span>
    </p>
    <CardFacts>
      <li>
        <GraduationCapIcon class="size-5 shrink-0" />
        <span>
          <span class="sr-only">Semestres:</span>
          <strong class="block whitespace-nowrap text-sm font-bold">
            {formatSemestres(curso.semestres)}
          </strong>
          semestre
        </span>
      </li>
      <li>
        <ClockIcon class="size-5 shrink-0" />
        <span>
          <span class="sr-only">Duración:</span>
          {
            curso.duracionHoras === null ? (
              <span class="font-medium text-muted">{PENDING}</span>
            ) : (
              <strong class="text-sm font-bold">
                {curso.duracionHoras}&nbsp;h
              </strong>
            )
          }
        </span>
      </li>
      {
        destino ? (
          <li>
            <UsersIcon class="size-5 shrink-0" />
            <span>
              <span class="sr-only">Cupo:</span>
              <strong class="text-sm font-bold">Sin inscripciones</strong>
            </span>
          </li>
        ) : (
          <CupoInfo parte="dato" {...cupo} />
        )
      }
    </CardFacts>
  </div>
  {!destino && <CupoInfo parte="barra" {...cupo} />}
</Card>


<style>
  /* ---------- Curso fusionado ---------- */

  /* Contenido atenuado: escala de grises y opacidad 0.6 (la franja y la cinta
     quedan fuera, en el slot "aviso" de Card). */
  :global(.fusionado-contenido) {
    filter: grayscale(1);
    opacity: 0.6;
  }

  /* Deja libre la esquina que ocupa la cinta */
  .franja-fusionado {
    padding-right: 6rem;
  }

  /* Cinta diagonal en la esquina superior derecha. La caja la recorta y la
     banda cruza la esquina a 45°, con su centro sobre la diagonal. */
  .cinta {
    --caja: 8rem;
    --ancho: 12rem;
    --alto: 2.25rem;
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    width: var(--caja);
    height: var(--caja);
    overflow: hidden;
    pointer-events: none;
  }

  .cinta span {
    position: absolute;
    top: calc(var(--caja) * 0.375 - var(--alto) / 2);
    right: calc(var(--caja) * 0.375 - var(--ancho) / 2);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--ancho);
    height: var(--alto);
    transform: rotate(45deg);
    /* Bordes marino: separan la cinta de la franja, del mismo ámbar */
    border-block: 2px solid var(--color-navy);
    background: var(--color-amber);
    box-shadow: 0 4px 10px -2px rgb(15 30 74 / 0.55);
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ver-curso:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }

  .requisitos-enlace:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }
</style>
