---
// Retícula de puntos decorativa. `id` debe ser único por página (patrón SVG).
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"svg"> {
  id: string;
}

const { id, ...rest } = Astro.props;
---

<svg viewBox="0 0 70 70" aria-hidden="true" {...rest}>
  <defs>
    <pattern id={id} width="10" height="10" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.3" fill="currentColor"></circle>
    </pattern>
  </defs>
  <rect width="70" height="70" fill={`url(#${id})`}></rect>
</svg>
