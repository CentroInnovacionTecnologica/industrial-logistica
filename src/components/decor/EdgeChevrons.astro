---
// Chevrons de marca que asoman por el borde izquierdo.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"svg"> {
  variant?: "top" | "bottom";
}

const { variant = "top", ...rest } = Astro.props;
---

<svg viewBox="0 0 70 180" aria-hidden="true" {...rest}>
  {
    variant === "top" ? (
      <>
        <polygon points="0,0 22,0 70,62 46,96 0,34" fill="var(--color-guinda)" />
        <polygon points="0,44 40,96 0,150" fill="var(--color-gold-dark)" />
        <polygon points="0,112 26,80 44,104 0,162" fill="var(--color-navy)" />
        <polygon points="0,62 14,80 0,98" fill="var(--color-gold)" />
      </>
    ) : (
      <>
        <polygon points="0,0 18,22 0,46" fill="var(--color-gold-dark)" />
        <polygon
          points="0,56 30,56 70,104 30,180 0,180"
          fill="var(--color-guinda)"
        />
        <polygon points="0,84 22,84 44,110 8,180 0,180" fill="var(--color-navy)" />
      </>
    )
  }
</svg>
