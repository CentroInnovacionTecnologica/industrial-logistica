---
/**
 * Tarjeta común a cursos, visitas y actividades deportivas: franja superior de
 * color, borde sutil y contenido en columna (los datos se pegan al fondo).
 */
interface Props {
  /** Clase de fondo de la franja superior (ver tonos.ts). */
  stripe: string;
  /** Relleno del contenido; por defecto "p-5". */
  padding?: string;
  /** Atenúa la tarjeta (p. ej. cupo lleno). 0.88 mantiene el texto gris en AA. */
  atenuada?: boolean;
}

const { stripe, padding = "p-5", atenuada = false } = Astro.props;
---

<article
  class:list={[
    "flex h-full flex-col overflow-hidden rounded-xl border border-line bg-white shadow-[0_8px_20px_-14px_rgb(15_30_74/0.4)]",
    atenuada && "opacity-[0.88]",
  ]}
>
  <div class:list={["h-2 shrink-0", stripe]} aria-hidden="true"></div>

  <div class:list={["flex flex-1 flex-col", padding]}>
    <slot />
  </div>
</article>
