---
/**
 * Fila de datos con íconos al fondo de una tarjeta. Cada dato es un <li>
 * (ícono + texto) que se pasa en el slot.
 */
---

<div class="mt-auto overflow-hidden border-t border-line pt-4">
  <ul class="facts text-[13px] leading-tight text-navy">
    <slot />
  </ul>
</div>

<style>
  /* Si los datos no caben en una fila (tarjeta angosta con "Por confirmar"),
     pasan a la siguiente. El margen negativo deja fuera del recorte la línea
     divisoria del primer dato de cada fila. */
  .facts {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.625rem;
    margin-left: calc(-0.625rem - 1px);
  }

  .facts > :global(li) {
    display: flex;
    flex-grow: 1;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding-left: 0.625rem;
    border-left: 1px solid var(--color-line);
  }
</style>
