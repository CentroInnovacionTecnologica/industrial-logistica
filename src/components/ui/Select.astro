---
import CheckIcon from "../icons/CheckIcon.astro";
import ChevronDownIcon from "../icons/ChevronDownIcon.astro";

export interface SelectOption {
  value: string;
  label: string;
}

interface BaseProps {
  /** Id del <select> nativo; la caja y el panel derivan el suyo de este. */
  id: string;
  name?: string;
  options: SelectOption[];
  /** Valor inicial; por defecto, la primera opción. */
  value?: string;
  /** Clases del contenedor (ancho, márgenes). `[--select-weight:500]` cambia el grosor del texto. */
  class?: string;
  /** Los atributos data-* pasan al <select> (p. ej. data-filter-tema). */
  [key: `data-${string}`]: string | boolean | undefined;
}

/** Nombre accesible: texto propio o id de la etiqueta visible. */
type Props = BaseProps &
  ({ label: string; labelledby?: never } | { labelledby: string; label?: never });

const {
  id,
  name,
  options,
  value,
  label,
  labelledby,
  class: className,
  ...rest
} = Astro.props;

const selected = options.find((option) => option.value === value) ?? options[0];
const listboxId = `${id}-lista`;
---

<div class:list={["select", className]} data-select>
  <!-- Fuente de verdad: sin JavaScript y en pantallas táctiles es el control visible -->
  <select
    id={id}
    name={name}
    class="field select-native"
    aria-label={label}
    aria-labelledby={labelledby}
    {...rest}
  >
    {
      options.map((option) => (
        <option value={option.value} selected={option === selected}>
          {option.label}
        </option>
      ))
    }
  </select>

  <div
    id={`${id}-caja`}
    class="field select-trigger"
    role="combobox"
    tabindex="0"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={listboxId}
    aria-label={label}
    aria-labelledby={labelledby}
    data-select-trigger
  >
    <span class="select-value" data-select-value>{selected?.label}</span>
  </div>

  <span class="select-chevron">
    <ChevronDownIcon class="size-5" />
  </span>

  <!-- El script lo mueve a <body> para que ningún contenedor lo recorte -->
  <ul
    id={listboxId}
    class="select-panel"
    role="listbox"
    aria-label={label}
    aria-labelledby={labelledby}
    hidden
    data-select-panel
  >
    {
      options.map((option, index) => (
        <li
          id={`${id}-opcion-${index}`}
          class="select-option"
          role="option"
          aria-selected={option === selected ? "true" : "false"}
        >
          <span>{option.label}</span>
          <span class="select-check">
            <CheckIcon class="size-[18px]" />
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .select {
    position: relative;
  }

  /* Caja cerrada: idéntica en el <select> nativo y en la caja personalizada */
  .select-native,
  .select-trigger {
    appearance: none;
    padding-left: 1rem;
    padding-right: 2.75rem;
    font-weight: var(--select-weight, 600);
  }

  .select-trigger {
    display: none;
    align-items: center;
    cursor: pointer;
    user-select: none;
  }

  .select[data-enhanced] .select-native {
    display: none;
  }

  .select[data-enhanced] .select-trigger {
    display: flex;
  }

  .select-trigger[aria-expanded="true"] {
    border-color: color-mix(in srgb, var(--color-navy) 40%, transparent);
  }

  .select-value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .select-chevron {
    position: absolute;
    right: 0.875rem;
    top: 50%;
    display: flex;
    translate: 0 -50%;
    color: var(--color-navy);
    pointer-events: none;
    transition: rotate 160ms ease-out;
  }

  .select[data-open] .select-chevron {
    rotate: 180deg;
  }

  /* Panel: posicionado por el script, por debajo del encabezado (z-40) */
  .select-panel {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 30;
    max-width: min(24rem, calc(100vw - 1rem));
    padding: 0.375rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: #fff;
    color: var(--color-navy);
    font-size: 0.9375rem;
    box-shadow:
      0 2px 6px rgb(15 30 74 / 0.08),
      0 14px 28px -12px rgb(15 30 74 / 0.28);
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
    opacity: 0;
    translate: 0 -4px;
    pointer-events: none;
    transition:
      opacity 110ms ease-in,
      translate 110ms ease-in;
  }

  .select-panel[data-placement="top"] {
    translate: 0 4px;
  }

  .select-panel[data-open] {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
    transition:
      opacity 160ms ease-out,
      translate 160ms ease-out;
  }

  .select-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-weight: 500;
    line-height: 1.3;
    cursor: pointer;
  }

  /* Un solo resaltado para cursor y teclado */
  .select-option[data-active] {
    background: var(--color-surface);
  }

  .select-option[aria-selected="true"] {
    font-weight: 700;
  }

  .select-check {
    display: flex;
    flex-shrink: 0;
    color: var(--color-gold-dark);
    visibility: hidden;
  }

  .select-option[aria-selected="true"] .select-check {
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .select-chevron,
    .select-panel,
    .select-panel[data-open] {
      transition: none;
    }
  }
</style>

<script>
  const GAP = 6; // separación entre la caja y el panel
  const MARGIN = 8; // aire mínimo contra los bordes de la ventana
  const MAX_HEIGHT = 320;
  const MIN_HEIGHT = 120;
  const CLOSE_MS = 110; // igual a la transición de salida
  const TYPEAHEAD_MS = 500;

  const coarse = window.matchMedia("(pointer: coarse)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const normalize = (text: string): string =>
    text
      .normalize("NFD")
      .replace(/\p{Diacritic}/gu, "")
      .trim()
      .toLowerCase();

  const setup = (root: HTMLElement): void => {
    const select = root.querySelector("select");
    const trigger = root.querySelector<HTMLElement>("[data-select-trigger]");
    const valueText = root.querySelector<HTMLElement>("[data-select-value]");
    const panel = root.querySelector<HTMLElement>("[data-select-panel]");
    if (!select || !trigger || !valueText || !panel) return;

    const items = [...panel.querySelectorAll<HTMLElement>('[role="option"]')];
    const labels = items.map((_, index) => normalize(select.options[index]?.text ?? ""));

    // Fuera de contenedores con overflow o contexto de apilamiento propio
    document.body.append(panel);

    let open = false;
    let active = -1;
    let search = "";
    let searchTimer = 0;
    let closeTimer = 0;

    /** Refleja en la caja y el panel el valor actual del <select>. */
    const sync = (): void => {
      const index = select.selectedIndex;
      valueText.textContent = select.options[index]?.text ?? "";
      items.forEach((item, i) => {
        item.setAttribute("aria-selected", String(i === index));
      });
    };

    const setActive = (index: number, scroll = true): void => {
      active = Math.min(Math.max(index, 0), items.length - 1);
      items.forEach((item, i) => item.toggleAttribute("data-active", i === active));

      const item = items[active];
      if (!item) return;
      trigger.setAttribute("aria-activedescendant", item.id);
      if (!scroll) return;

      // Sin scrollIntoView: solo se desplaza el panel, nunca la página
      const top = item.offsetTop;
      const bottom = top + item.offsetHeight;
      if (top < panel.scrollTop) panel.scrollTop = top - 6;
      else if (bottom > panel.scrollTop + panel.clientHeight) {
        panel.scrollTop = bottom - panel.clientHeight + 6;
      }
    };

    /** Abre hacia abajo; hacia arriba si no cabe sin salirse de <main> o de la ventana. */
    const place = (): void => {
      const rect = trigger.getBoundingClientRect();
      panel.style.minWidth = `${rect.width}px`;
      panel.style.maxHeight = `${MAX_HEIGHT}px`;
      const needed = panel.offsetHeight;

      const header =
        parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const below = window.innerHeight - rect.bottom - GAP - MARGIN;
      const above = rect.top - header - GAP - MARGIN;
      const main = root.closest("main");
      const belowInMain = main
        ? Math.min(below, main.getBoundingClientRect().bottom - rect.bottom - GAP)
        : below;

      const up =
        needed > belowInMain && (needed <= above || (needed > below && above > below));
      const available = up ? above : below;
      panel.style.maxHeight = `${Math.min(MAX_HEIGHT, Math.max(available, MIN_HEIGHT))}px`;
      panel.dataset.placement = up ? "top" : "bottom";

      const maxLeft =
        document.documentElement.clientWidth - panel.offsetWidth - MARGIN;
      const left = Math.max(MARGIN, Math.min(rect.left, maxLeft));
      const top = up ? rect.top - GAP - panel.offsetHeight : rect.bottom + GAP;
      panel.style.left = `${left + window.scrollX}px`;
      panel.style.top = `${top + window.scrollY}px`;
    };

    const onOutsidePointer = (event: PointerEvent): void => {
      const target = event.target as Node;
      if (!root.contains(target) && !panel.contains(target)) closePanel();
    };

    const openPanel = (index = select.selectedIndex): void => {
      if (open || !items.length) return;
      open = true;
      window.clearTimeout(closeTimer);
      sync();

      panel.hidden = false;
      place();
      setActive(index);
      void panel.offsetWidth; // fija el estado inicial de la transición
      panel.toggleAttribute("data-open", true);
      root.toggleAttribute("data-open", true);
      trigger.setAttribute("aria-expanded", "true");

      document.addEventListener("pointerdown", onOutsidePointer);
      window.addEventListener("resize", place);
    };

    function closePanel(focus = false): void {
      if (focus) trigger.focus();
      if (!open) return;
      open = false;
      search = "";

      panel.removeAttribute("data-open");
      root.removeAttribute("data-open");
      trigger.setAttribute("aria-expanded", "false");
      trigger.removeAttribute("aria-activedescendant");

      document.removeEventListener("pointerdown", onOutsidePointer);
      window.removeEventListener("resize", place);

      if (reducedMotion.matches) panel.hidden = true;
      else {
        closeTimer = window.setTimeout(() => {
          panel.hidden = true;
        }, CLOSE_MS);
      }
    }

    /** El <select> recibe el valor y avisa con "change", como si lo eligiera el usuario. */
    const choose = (index: number): void => {
      if (index >= 0 && index !== select.selectedIndex) {
        select.selectedIndex = index;
        select.dispatchEvent(new Event("input", { bubbles: true }));
        select.dispatchEvent(new Event("change", { bubbles: true }));
      }
      closePanel(true);
    };

    /** Salta a la opción que empieza con lo escrito; repetir una letra recorre las coincidencias. */
    const typeahead = (char: string): void => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        search = "";
      }, TYPEAHEAD_MS);
      search += normalize(char) || char;

      const repeated = [...search].every((letter) => letter === search[0]);
      const query = repeated ? search[0] : search;
      const from = repeated ? active + 1 : active;
      for (let step = 0; step < items.length; step++) {
        const index = (from + step + items.length) % items.length;
        if (labels[index].startsWith(query)) {
          setActive(index);
          return;
        }
      }
    };

    trigger.addEventListener("click", () => {
      if (open) closePanel(true);
      else {
        trigger.focus();
        openPanel();
      }
    });

    trigger.addEventListener("keydown", (event) => {
      const { key } = event;
      if (event.ctrlKey || event.metaKey) return;

      if (key.length === 1 && (key !== " " || search)) {
        event.preventDefault();
        openPanel();
        typeahead(key);
        return;
      }

      if (!open) {
        if (key === "Enter" || key === " " || key === "ArrowDown" || key === "ArrowUp") {
          event.preventDefault();
          openPanel();
        } else if (key === "Home" || key === "End") {
          event.preventDefault();
          openPanel(key === "Home" ? 0 : items.length - 1);
        }
        return;
      }

      const moves: Record<string, number> = {
        ArrowDown: active + 1,
        ArrowUp: active - 1,
        PageDown: active + 10,
        PageUp: active - 10,
        Home: 0,
        End: items.length - 1,
      };

      if (key === "Tab") {
        // Como el <select> nativo: confirma y deja que el foco siga su camino
        choose(active);
      } else if (key === "Escape") {
        event.preventDefault();
        closePanel(true);
      } else if (key === "Enter" || key === " " || (key === "ArrowUp" && event.altKey)) {
        event.preventDefault();
        choose(active);
      } else if (key in moves) {
        event.preventDefault();
        setActive(moves[key]);
      }
    });

    trigger.addEventListener("blur", () => closePanel());

    // El foco se queda en la caja mientras se usa el panel con el ratón
    panel.addEventListener("mousedown", (event) => event.preventDefault());

    panel.addEventListener("pointermove", (event) => {
      const item = (event.target as Element).closest<HTMLElement>('[role="option"]');
      const index = item ? items.indexOf(item) : -1;
      if (index >= 0 && index !== active) setActive(index, false);
    });

    panel.addEventListener("click", (event) => {
      const item = (event.target as Element).closest<HTMLElement>('[role="option"]');
      if (item) choose(items.indexOf(item));
    });

    // La etiqueta visible apunta al <select>, que aquí está oculto: el foco va a la caja
    for (const label of select.labels) {
      label.addEventListener("click", (event) => {
        if (!root.hasAttribute("data-enhanced")) return;
        event.preventDefault();
        trigger.focus();
      });
    }

    // Asignar select.value o select.selectedIndex desde código no emite eventos:
    // se interceptan en esta instancia para que la caja siempre lo refleje.
    for (const property of ["value", "selectedIndex"] as const) {
      const native = Object.getOwnPropertyDescriptor(
        HTMLSelectElement.prototype,
        property,
      );
      if (!native?.get || !native.set) continue;
      const { get, set } = native;
      Object.defineProperty(select, property, {
        configurable: true,
        enumerable: true,
        get: () => get.call(select),
        set: (next) => {
          set.call(select, next);
          sync();
        },
      });
    }

    select.addEventListener("change", sync);
    select.form?.addEventListener("reset", () => window.setTimeout(sync));
    // El navegador puede restaurar el valor al recargar o volver
    window.addEventListener("pageshow", sync);

    // En pantallas táctiles se conserva el selector nativo del sistema
    const applyMode = (): void => {
      closePanel();
      root.toggleAttribute("data-enhanced", !coarse.matches);
      sync();
    };
    coarse.addEventListener("change", applyMode);
    applyMode();
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-select]")) {
    setup(root);
  }
</script>
