---
/**
 * Código de vestimenta y reglamento de las visitas (datos en
 * src/data/reglamentoVisitas.ts). El desplazamiento suave y el margen bajo el
 * encabezado fijo vienen de los estilos globales de `html`.
 */
import type { PuntoReglamento } from "../../data/reglamentoVisitas";
import { reglamentoVisitas } from "../../data/reglamentoVisitas";
import AlertIcon from "../icons/AlertIcon.astro";
import CameraOffIcon from "../icons/CameraOffIcon.astro";
import IdCardIcon from "../icons/IdCardIcon.astro";
import ShieldCheckIcon from "../icons/ShieldCheckIcon.astro";
import ShirtIcon from "../icons/ShirtIcon.astro";
import Card from "../ui/Card.astro";

// En el mismo orden que las secciones de los datos.
const iconos = [ShirtIcon, ShieldCheckIcon, CameraOffIcon, IdCardIcon];

/** Separa el punto en antes / destacado / después. */
function partes({ texto, destacado }: PuntoReglamento) {
  const inicio = destacado ? texto.indexOf(destacado) : -1;
  if (!destacado || inicio === -1) {
    return { antes: texto, negritas: "", despues: "" };
  }
  return {
    antes: texto.slice(0, inicio),
    negritas: destacado,
    despues: texto.slice(inicio + destacado.length),
  };
}
---

<section
  id="reglamento"
  class="bg-surface py-10 lg:py-14"
  aria-labelledby="reglamento-titulo"
>
  <div class="site-container">
    <header class="max-w-3xl">
      <h2
        id="reglamento-titulo"
        class="font-display text-2xl font-extrabold leading-tight text-navy sm:text-3xl"
      >
        {reglamentoVisitas.titulo}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-navy">
        {reglamentoVisitas.intro}
      </p>
    </header>

    <div class="mt-6 grid gap-5 lg:mt-8 lg:grid-cols-2 lg:gap-6">
      {
        reglamentoVisitas.secciones.map((seccion, indice) => {
          const Icono = iconos[indice] ?? AlertIcon;
          return (
            <Card stripe="bg-guinda-gradient" padding="p-5 sm:p-6">
              <div class="flex items-center gap-3">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-accent-red/10 text-accent-red">
                  <Icono class="size-6" />
                </span>
                <h3 class="font-display text-lg font-bold leading-snug text-navy sm:text-xl">
                  {seccion.titulo}
                </h3>
              </div>

              <ul class="mt-4 list-disc space-y-2 pl-5 text-base leading-relaxed text-navy marker:text-accent-red">
                {seccion.puntos.map((punto) => {
                  const { antes, negritas, despues } = partes(punto);
                  return (
                    <li>
                      {antes}
                      {negritas && <strong class="font-bold">{negritas}</strong>}
                      {despues}
                    </li>
                  );
                })}
              </ul>
            </Card>
          );
        })
      }
    </div>

    <div
      role="note"
      aria-labelledby="reglamento-importante"
      class="mt-5 flex flex-col gap-3 rounded-xl border-l-8 border-guinda bg-navy p-5 text-white shadow-[0_8px_20px_-14px_rgb(15_30_74/0.4)] sm:flex-row sm:gap-4 sm:p-6 lg:mt-6"
    >
      <AlertIcon class="size-7 shrink-0 text-gold" />
      <div>
        <p
          id="reglamento-importante"
          class="font-display text-sm font-extrabold uppercase tracking-widest text-gold"
        >
          Importante
        </p>
        <p class="mt-1.5 text-base leading-relaxed">
          {reglamentoVisitas.importante}
        </p>
      </div>
    </div>
  </div>
</section>
