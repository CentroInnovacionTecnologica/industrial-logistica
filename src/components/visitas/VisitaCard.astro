---
import { Image } from "astro:assets";
import {
  carreraVisitaLabels,
  iniciales,
  logoDeVisita,
  visitasInfo,
} from "../../data/visitas";
import type { Visita } from "../../data/visitas";
import ClockIcon from "../icons/ClockIcon.astro";
import UsersIcon from "../icons/UsersIcon.astro";
import Card from "../ui/Card.astro";
import CardFacts from "../ui/CardFacts.astro";
import { tonos } from "../ui/tonos";

interface Props {
  visita: Visita;
}

const { visita } = Astro.props;

const tone = tonos[visita.carrera];
const logo = logoDeVisita(visita);

// Tope del archivo generado: suficiente para pantallas de alta densidad sin
// servir originales enormes. Nunca supera el ancho original del logo.
const LOGO_MAX_WIDTH = 720;
---

<Card stripe={tone.stripe}>
  <!-- Área del logo: alto fijo; el logo se centra sin deformarse ni ampliarse -->
  <div
    class:list={[
      "flex h-24 items-center justify-center overflow-hidden rounded-lg border sm:h-28 lg:h-[7.5rem]",
      logo ? "border-line bg-white p-4 lg:p-5" : "border-transparent bg-surface",
    ]}
  >
    {
      logo ? (
        <Image
          src={logo}
          alt={visita.empresa}
          width={Math.min(logo.width, LOGO_MAX_WIDTH)}
          class="logo"
        />
      ) : (
        <div
          class="font-display text-3xl font-extrabold tracking-wider text-muted lg:text-4xl"
          role="img"
          aria-label={visita.empresa}
        >
          <span aria-hidden="true">{iniciales(visita.empresa)}</span>
        </div>
      )
    }
  </div>

  <p
    class:list={[
      "mt-4 self-start rounded-full px-3 py-1.5 text-[13px] font-semibold leading-tight",
      tone.tag,
    ]}
  >
    <span class="sr-only">Carrera:</span>
    {carreraVisitaLabels[visita.carrera]}
  </p>

  <h3 class="mt-3 font-display text-lg font-bold leading-snug text-navy">
    {visita.empresa}
  </h3>
  <p class="mt-2 pb-5 text-[15px] leading-relaxed text-muted">
    {visita.descripcion}
  </p>

  <CardFacts>
    <li>
      <UsersIcon class="size-5 shrink-0" />
      <span>
        <span class="sr-only">Cupo:</span>
        <strong class="block text-sm font-bold">{visita.lugares}</strong>
        lugares
      </span>
    </li>
    <li>
      <ClockIcon class="size-5 shrink-0" />
      <span>
        <span class="sr-only">Salida:</span>
        <strong class="block text-sm font-bold">
          {visitasInfo.salida}<span class="sr-only">,</span>
        </strong>
        {visitasInfo.puntoDeSalida}
      </span>
    </li>
  </CardFacts>
</Card>

<style>
  /* Tamaño natural como tope: un logo pequeño (p. ej. 220 × 46 px) no se
     amplía ni se ve borroso; uno grande se reduce para caber en el área. */
  .logo {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
</style>
