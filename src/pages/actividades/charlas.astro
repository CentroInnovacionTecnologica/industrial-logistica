---
import EventoCard from "../../components/eventos/EventoCard.astro";
import Header from "../../components/Header.astro";
import CalendarIcon from "../../components/icons/CalendarIcon.astro";
import HexNetworkIcon from "../../components/icons/HexNetworkIcon.astro";
import MessagesIcon from "../../components/icons/MessagesIcon.astro";
import PageHeader from "../../components/PageHeader.astro";
import { tonos } from "../../components/ui/tonos";
import { charlas, charlasOrdenadas } from "../../data/charlas";
import BaseLayout from "../../layouts/BaseLayout.astro";

const total = charlas.length;

const stats = [
  { icon: MessagesIcon, text: `${total} ${total === 1 ? "charla" : "charlas"}` },
  { icon: HexNetworkIcon, text: "Semana Académica NEXUS" },
  { icon: CalendarIcon, text: "24 al 27 de noviembre" },
];
---

<BaseLayout
  title="Charlas | Semana Académica ITD"
  description="Conoce las charlas de la Semana Académica de Ingeniería Industrial e Ingeniería en Logística del ITD, del 24 al 27 de noviembre de 2026: talento hacia 2030, logística farmacéutica y marca personal."
>
  <Header />

  <main id="contenido">
    <PageHeader
      title="Charlas"
      breadcrumb={[{ label: "Actividades" }, { label: "Charlas" }]}
      stats={stats}
    />

    <section
      class="site-container pb-10 pt-5 lg:pb-12 lg:pt-6"
      aria-labelledby="charlas-titulo"
    >
      <h2 id="charlas-titulo" class="sr-only">Charlas programadas</h2>

      <ul role="list" class="grid gap-5 md:grid-cols-2 lg:gap-6">
        {
          charlasOrdenadas.map((charla) => (
            <li>
              <EventoCard evento={charla} etiqueta="Charla" tono={tonos.ambas} />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
