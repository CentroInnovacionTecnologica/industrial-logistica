---
import EventoCard from "../../components/eventos/EventoCard.astro";
import Header from "../../components/Header.astro";
import MessagesIcon from "../../components/icons/MessagesIcon.astro";
import MicrophoneIcon from "../../components/icons/MicrophoneIcon.astro";
import UserIcon from "../../components/icons/UserIcon.astro";
import PageHeader from "../../components/PageHeader.astro";
import { tonos } from "../../components/ui/tonos";
import {
  conferencias,
  conferenciasOrdenadas,
  tipoDeConferencia,
} from "../../data/conferencias";
import BaseLayout from "../../layouts/BaseLayout.astro";

const total = conferencias.length;
const magistrales = conferencias.filter(
  (conferencia) => tipoDeConferencia(conferencia) === "Conferencia magistral",
).length;

const stats = [
  { icon: MessagesIcon, text: `${total} ${total === 1 ? "conferencia" : "conferencias"}` },
  { icon: UserIcon, text: "Ponentes invitados" },
  {
    icon: MicrophoneIcon,
    text: `${magistrales} ${magistrales === 1 ? "conferencia magistral" : "conferencias magistrales"}`,
  },
];
---

<BaseLayout
  title="Conferencias | Semana Académica ITD"
  description="Conoce las conferencias de la Semana Académica de Ingeniería Industrial e Ingeniería en Logística del ITD, del 24 al 27 de noviembre de 2026, con ponentes invitados."
>
  <Header />

  <main id="contenido">
    <PageHeader
      title="Conferencias"
      breadcrumb={[{ label: "Actividades" }, { label: "Conferencias" }]}
      stats={stats}
    />

    <section
      class="site-container pb-10 pt-5 lg:pb-12 lg:pt-6"
      aria-labelledby="conferencias-titulo"
    >
      <h2 id="conferencias-titulo" class="sr-only">Conferencias programadas</h2>

      <ul role="list" class="grid gap-5 md:grid-cols-2 lg:gap-6">
        {
          conferenciasOrdenadas.map((conferencia) => (
            <li class:list={[conferencia.destacada && "md:col-span-2"]}>
              <EventoCard
                evento={conferencia}
                etiqueta={tipoDeConferencia(conferencia)}
                tono={tonos.industrial}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
