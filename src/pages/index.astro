---
import FilterBar from "../components/FilterBar.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import { sections } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Header />

  <main id="contenido">
    <Hero />

    <section
      id={sections.upcoming.id}
      class="site-container scroll-mt-4 py-4 lg:py-5"
      aria-labelledby="proximos-eventos-titulo"
    >
      <h2 id="proximos-eventos-titulo" class="sr-only">
        {sections.upcoming.title}
      </h2>
      <FilterBar />

      <!-- Tarea posterior: cuadrícula de tarjetas de eventos (escuchan "eventos:filtrar") -->
    </section>

    <!-- Tarea posterior: <section id="eventos-pasados"> -->
  </main>
</BaseLayout>
