---
import Aviso from "../components/Aviso.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import KitSection from "../components/KitSection.astro";
import PatrocinadoresCarousel from "../components/PatrocinadoresCarousel.astro";
import { avisoInauguracion, avisoKit } from "../data/avisos";
import { sections } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Header />

  <main id="contenido">
    <!-- Avisos importantes, arriba del hero. Fondo blanco como el inicio del
         degradado del hero para que no se note el corte; el relleno inferior
         separa los avisos de la foto del hero. -->
    <section class="bg-white" aria-labelledby="avisos-titulo">
      <div class="site-container pb-6 pt-5 sm:pt-6 lg:pb-8 lg:pt-7">
        <h2 id="avisos-titulo" class="sr-only">Avisos importantes</h2>
        <div class="grid gap-4 lg:grid-cols-2 lg:gap-6">
          <Aviso aviso={avisoInauguracion} variante="urgente" nivel={3} denso />
          <Aviso aviso={avisoKit} variante="importante" nivel={3} denso />
        </div>
      </div>
    </section>

    <Hero />

    <PatrocinadoresCarousel />

    <!-- El aviso del kit ya aparece completo arriba: aquí va compacto -->
    <KitSection avisoCompacto />

    <!-- Ancla del enlace "Actividades" del pie de página.
         Tarea posterior: <section> con su título y la cuadrícula de tarjetas de eventos -->
    <div id={sections.activities.id}></div>

    <!-- Tarea posterior: <section id="galeria"> -->
  </main>
</BaseLayout>
